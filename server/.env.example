# 複製這個檔為 server/.env 並填入自己的值（server/.env 不會進 git）
# 正式上線前務必修改 ADMIN_PASSWORD 與 JWT_SECRET

# 後端埠號
PORT=3001

# 後台登入密碼
ADMIN_PASSWORD=admin1234

# 簽發登入 token 的密鑰（請換成隨機長字串，例如 openssl rand -hex 32）
JWT_SECRET=dev-secret-please-change

# 網站掛的子路徑（必須與 vite.config 的 base 一致）。留空 = 網域根目錄
BASE_PATH=/tsio-design
